# Playable Lessons — self-hosted server config
# Place this file as .env in the same directory as docker-compose.yml.

# ─── AI provider (set ONE) ───
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI:
# OPENAI_API_KEY=sk-...

# Ollama (local/remote):
# OLLAMA_URL=http://localhost:11434
# OLLAMA_TOKEN=

# ─── Model ───
# Specify the model to use. Defaults if omitted:
#   Claude:  claude-sonnet-4-20250514
#   OpenAI:  gpt-4o
#   Ollama:  llama3.1:8b
MODEL=claude-sonnet-4-20250514

# ─── Access gate ───
# Comma-separated for multiple groups (e.g. staff-2024,pilot-group,admin).
# Revoke access by removing a code and restarting.
# Leave blank for no gate (open access).
ACCESS_CODE=

# ─── Limits ───
RATE_LIMIT_PER_HOUR=30
MAX_INPUT_CHARS=20000
PORT=3000
# Set to 1 when the app sits behind ONE reverse proxy (nginx/Caddy) —
# otherwise every visitor shares one rate-limit bucket. Leave unset when the
# app port is directly exposed (trusting X-Forwarded-For would allow spoofing).
# TRUST_PROXY=1

# ─── Scene images (optional) ───
# Master switch: the web UI only shows the "illustrate every scene" option
# when this is on AND a provider below is configured.
# SCENE_IMAGES=true
#
# Provider: openai | gemini | custom. Default inference:
#   GEMINI_API_KEY set → gemini; IMAGE_BASE_URL set → custom; else OPENAI_API_KEY → openai.
# IMAGE_PROVIDER=gemini
#
# Gemini (Google Imagen — cheap, fast, ~$0.02/image; default imagen-4.0-fast-generate-001):
# GEMINI_API_KEY=AIza...
#
# OpenAI (gpt-image-1 by default; reuses OPENAI_API_KEY unless IMAGE_API_KEY is set):
# IMAGE_API_KEY=sk-...
#
# Custom — any OpenAI-compatible /v1/images endpoint, e.g. the optional
# LocalAI service in docker-compose.yml (docker compose --profile images up -d):
# IMAGE_PROVIDER=custom
# IMAGE_BASE_URL=http://localai:8080/v1
# IMAGE_MODEL=stablediffusion
# IMAGE_API_KEY=            # usually blank for a local endpoint
#
# Tweaks:
# IMAGE_SIZE=512x512        # custom default is 512x512 (CPU-friendly); OpenAI default 1024x1024; Gemini takes an aspect ratio like 4:3
# IMAGE_STYLE=cartoon       # server default: cartoon | photorealistic (users can switch in the UI)
# IMAGE_MAX_SCENES=8        # per-story cap — bounds cost/time on a public server
